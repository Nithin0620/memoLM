# MemoLM backend configuration. Copy to `.env` and fill in. Never commit real values.

# --- Upstream LLM provider (Groq) ---
GROQ_API_KEY=
# Model access is per-API-key. List what yours can reach:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-20b

# --- Vector store (Qdrant) ---
# Local:  docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
