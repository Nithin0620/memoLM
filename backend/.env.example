# MemoLM backend configuration. Copy to `.env` and fill in. Never commit real values.

# --- Which provider to use when a request does not name one ---
# A request may override this per call via the x-memolm-provider header or the
# "provider" body field, but only among providers that have a key set below.
# An unknown or unconfigured provider returns 400.
MEMOLM_DEFAULT_PROVIDER=groq

# --- Upstream LLM providers ---
# Set only the ones you use. A provider with a blank key is reported as
# unconfigured and returns a 400 rather than a confusing upstream 401.
# Model access is per-API-key: list what your key can reach, e.g.
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# *_BASE_URL is optional. Leave blank for the vendor default. Setting it is how
# you point ChatOpenAI at any OpenAI-compatible endpoint (vLLM, LM Studio,
# OpenRouter, Together, NVIDIA NIM).

# Groq — fastest for open-weight models.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=

# OpenAI — also fronts any OpenAI-compatible endpoint via OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Anthropic. max_tokens is required by this API; MemoLM supplies a default
# (provider/base.py DEFAULT_MAX_TOKENS) so answers are not silently truncated.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=

# Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=

# --- Vector store (Qdrant) ---
# Local:  docker run -p 6333:6333 qdrant/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
