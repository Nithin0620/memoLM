# Server Configuration
HOST=0.0.0.0
PORT=8000
MEMOLM_ENV=development
MEMOLM_MOCK_MODE=false

# LLM Providers (At least one required if not in mock mode)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Databases
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=memolm_semantic_entries

# Safety & Caching Defaults
DEFAULT_TENANT=default
DEFAULT_KNOWLEDGE_VERSION=v1
DEFAULT_PROMPT_VERSION=v1
DEFAULT_TTL_SECONDS=86400
DEFAULT_SIMILARITY_THRESHOLD=0.88

# Embedding Model (openai or fastembed)
EMBEDDING_PROVIDER=openai
